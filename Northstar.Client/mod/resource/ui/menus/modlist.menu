		PageButtonU
		{
			ControlName			RuiButton
			Classname			GridButtonPage
			InheritProperties	GridPageArrowButtonUp
			xpos			-240
			ypos			60
			wide			128
			tall			64
			visible			1
			scaleImage		1
			drawColor		"255 255 255 255"

			zpos			300

			pin_to_sibling Panel1
			pin_corner_to_sibling TOP_LEFT
			pin_to_sibling_corner TOP_LEFT
		}

